<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Flores para ti 🌻</title>

<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family: Georgia, serif;
    overflow: hidden;
    background: linear-gradient(180deg, #050505, #15100a);
    color: white;
}


/* =========================
   PANTALLA INICIAL
========================= */

.inicio {
    position: fixed;
    inset: 0;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    text-align: center;

    z-index: 10;

    background:
        radial-gradient(
            circle at center,
            #443300 0%,
            #120f05 45%,
            #030303 100%
        );
}


.inicio h1 {
    font-size: clamp(35px, 7vw, 75px);

    margin-bottom: 10px;

    color: #ffd83d;

    text-shadow:
        0 0 10px #ffcc00,
        0 0 30px #ff9900,
        0 0 60px #ffcc00;

    animation: brillo 2s infinite alternate;
}


.inicio p {
    font-size: 20px;
    opacity: .85;
}


/* BOTÓN */

.boton {
    margin-top: 30px;

    padding: 16px 35px;

    border: none;
    border-radius: 50px;

    cursor: pointer;

    color: #3b2900;

    background:
        linear-gradient(
            45deg,
            #ffd700,
            #fff176,
            #ffca28
        );

    font-size: 18px;
    font-weight: bold;

    box-shadow:
        0 0 20px #ffd700;

    transition: .3s;
}


.boton:hover {

    transform: scale(1.1);

    box-shadow:
        0 0 40px #ffd700;
}


/* =========================
   JARDÍN
========================= */

.jardin {

    position: fixed;

    inset: 0;

    opacity: 0;

    pointer-events: none;

    transition: opacity 2s;

    background:
        radial-gradient(
            circle at 50% 30%,
            #493700,
            #171206 45%,
            #030303
        );
}


.jardin.activo {

    opacity: 1;

    pointer-events: auto;
}


/* =========================
   MENSAJE PRINCIPAL
========================= */

.mensaje {

    position: absolute;

    top: 5%;

    left: 50%;

    transform: translateX(-50%);

    width: 90%;

    text-align: center;

    z-index: 5;
}


.mensaje h2 {

    font-size: clamp(30px, 5vw, 55px);

    color: #ffe45c;

    text-shadow:
        0 0 15px #ffc400;

    animation: aparecer 2s ease;

    margin: 0 0 8px;
}


.mensaje p {

    font-size: 20px;

    color: #fff8cf;

    margin: 0;
}


/* =========================
   FOTO
========================= */

.foto-card {

    position: absolute;

    top: 24%;

    left: 50%;

    transform: translateX(-50%);

    width: min(330px, 70vw);

    padding: 9px;

    background: rgba(255, 244, 190, 0.96);

    border-radius: 18px;

    box-shadow:
        0 0 30px rgba(255, 211, 48, .65);

    z-index: 6;

    animation: fotoEntrar 1.8s ease;
}


/* IMAGEN */

.foto-card img {

    display: block;

    width: 100%;

    height: 220px;

    object-fit: cover;

    border-radius: 12px;
}


/* MENSAJE DEBAJO DE LA FOTO */

.texto-foto {

    color: #4a3500;

    font-size: 17px;

    font-weight: bold;

    line-height: 1.35;

    margin: 10px 5px 4px;

    text-align: center;
}


/* =========================
   FLORES
========================= */

.flores {

    position: absolute;

    bottom: 0;

    width: 100%;

    height: 43%;
}


.flor {

    position: absolute;

    bottom: 0;

    width: 120px;

    height: 220px;

    transform-origin: bottom;

    animation:
        balanceo 4s ease-in-out infinite;
}


/* TALLO */

.tallo {

    position: absolute;

    bottom: 0;

    left: 58px;

    width: 7px;

    height: 155px;

    background:
        linear-gradient(
            to right,
            #1b6b25,
            #4caf50,
            #17551c
        );

    border-radius: 10px;
}


/* HOJAS */

.hoja {

    position: absolute;

    width: 65px;

    height: 28px;

    background: #328b35;

    border-radius: 100% 0;
}


.hoja1 {

    left: 10px;

    bottom: 55px;

    transform: rotate(25deg);
}


.hoja2 {

    right: 5px;

    bottom: 95px;

    transform: rotate(-25deg);
}


/* CABEZA DE LA FLOR */

.cabeza {

    position: absolute;

    top: 5px;

    left: 28px;

    width: 65px;

    height: 65px;

    background: #ffb900;

    border-radius: 50%;

    box-shadow:
        0 0 25px #ffca00;

    z-index: 2;
}


/* PÉTALOS */

.petalo {

    position: absolute;

    width: 35px;

    height: 60px;

    background:
        linear-gradient(
            #fff176,
            #ffc400
        );

    border-radius: 50%;

    left: 15px;

    top: -25px;

    transform-origin: 18px 58px;
}


.petalo:nth-child(1) {
    transform: rotate(0deg);
}

.petalo:nth-child(2) {
    transform: rotate(45deg);
}

.petalo:nth-child(3) {
    transform: rotate(90deg);
}

.petalo:nth-child(4) {
    transform: rotate(135deg);
}

.petalo:nth-child(5) {
    transform: rotate(180deg);
}

.petalo:nth-child(6) {
    transform: rotate(225deg);
}

.petalo:nth-child(7) {
    transform: rotate(270deg);
}

.petalo:nth-child(8) {
    transform: rotate(315deg);
}


/* CENTRO */

.centro {

    position: absolute;

    width: 35px;

    height: 35px;

    background: #6b3e00;

    border-radius: 50%;

    left: 15px;

    top: 15px;

    z-index: 4;

    box-shadow:
        inset 0 0 8px #1e1200;
}


/* =========================
   POSICIÓN DE FLORES
========================= */

.flor1 {

    left: 2%;

    transform: scale(.7);

    animation-delay: .2s;
}


.flor2 {

    left: 22%;

    transform: scale(.85);

    animation-delay: 1s;
}


.flor3 {

    left: 43%;

    transform: scale(.72);

    animation-delay: .5s;
}


.flor4 {

    left: 64%;

    transform: scale(.9);

    animation-delay: 1.5s;
}


.flor5 {

    left: 84%;

    transform: scale(.65);

    animation-delay: .8s;
}


/* =========================
   PARTÍCULAS
========================= */

.particula {

    position: absolute;

    width: 5px;

    height: 5px;

    background: #ffd700;

    border-radius: 50%;

    box-shadow:
        0 0 10px #ffd700;

    animation:
        subir linear infinite;
}


/* =========================
   CORAZONES
========================= */

.corazon {

    position: absolute;

    color: #ffd700;

    font-size: 25px;

    animation:
        subir 6s linear infinite;

    text-shadow:
        0 0 15px #ffcc00;
}


/* =========================
   ANIMACIONES
========================= */

@keyframes brillo {

    from {
        filter: brightness(1);
    }

    to {
        filter: brightness(1.5);
    }
}


@keyframes balanceo {

    0%, 100% {
        rotate: -3deg;
    }

    50% {
        rotate: 3deg;
    }
}


@keyframes aparecer {

    from {

        opacity: 0;

        transform:
            translateY(-30px);
    }

    to {

        opacity: 1;

        transform:
            translateY(0);
    }
}


@keyframes fotoEntrar {

    from {

        opacity: 0;

        transform:
            translateX(-50%)
            scale(.65)
            rotate(-4deg);
    }

    to {

        opacity: 1;

        transform:
            translateX(-50%)
            scale(1)
            rotate(0);
    }
}


@keyframes subir {

    from {

        transform:
            translateY(100vh);

        opacity: 0;
    }

    20% {
        opacity: 1;
    }

    100% {

        transform:
            translateY(-100vh);

        opacity: 0;
    }
}


/* =========================
   CELULARES / PANTALLAS PEQUEÑAS
========================= */

@media (max-height: 700px) {

    .mensaje {
        top: 3%;
    }

    .mensaje h2 {
        font-size: 30px;
    }

    .mensaje p {
        font-size: 15px;
    }

    .foto-card {

        top: 20%;

        width:
            min(270px, 62vw);
    }

    .foto-card img {

        height: 160px;
    }

    .texto-foto {

        font-size: 14px;
    }

    .flores {

        height: 35%;
    }
}

</style>

</head>


<body>


<!-- =========================
     PANTALLA INICIAL
========================= -->

<div class="inicio" id="inicio">

    <h1>
        Para alguien especial 🌻
    </h1>

    <p>
        Hay algo que quiero enseñarte...
    </p>

    <button
        class="boton"
        onclick="abrirFlores()">

        ✨ Haz clic aquí ✨

    </button>

</div>



<!-- =========================
     JARDÍN
========================= -->

<div
    class="jardin"
    id="jardin">


    <!-- MENSAJE PRINCIPAL -->

    <div class="mensaje">

        <h2>
            Estas flores son para ti 🌻
        </h2>

        <p>
            Porque incluso en los días más oscuros,
            siempre puede existir un poquito de luz.
        </p>

    </div>



    <!-- =========================
         FOTO
    ========================= -->

    <div class="foto-card">

        <img
            src="foto.jpg"
            alt="Nuestra foto">

        <div class="texto-foto">

            "esta es la unica foto que tenia contigo JAJAJA"

        </div>

    </div>



    <!-- =========================
         FLORES
    ========================= -->

    <div class="flores">


        <!-- FLOR 1 -->

        <div class="flor flor1">

            <div class="tallo"></div>

            <div class="hoja hoja1"></div>

            <div class="hoja hoja2"></div>

            <div class="cabeza">

                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>

                <div class="centro"></div>

            </div>

        </div>



        <!-- FLOR 2 -->

        <div class="flor flor2">

            <div class="tallo"></div>

            <div class="hoja hoja1"></div>

            <div class="hoja hoja2"></div>

            <div class="cabeza">

                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>

                <div class="centro"></div>

            </div>

        </div>



        <!-- FLOR 3 -->

        <div class="flor flor3">

            <div class="tallo"></div>

            <div class="hoja hoja1"></div>

            <div class="hoja hoja2"></div>

            <div class="cabeza">

                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>

                <div class="centro"></div>

            </div>

        </div>



        <!-- FLOR 4 -->

        <div class="flor flor4">

            <div class="tallo"></div>

            <div class="hoja hoja1"></div>

            <div class="hoja hoja2"></div>

            <div class="cabeza">

                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>

                <div class="centro"></div>

            </div>

        </div>



        <!-- FLOR 5 -->

        <div class="flor flor5">

            <div class="tallo"></div>

            <div class="hoja hoja1"></div>

            <div class="hoja hoja2"></div>

            <div class="cabeza">

                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>
                <div class="petalo"></div>

                <div class="centro"></div>

            </div>

        </div>


    </div>

</div>



<!-- =========================
     JAVASCRIPT
========================= -->

<script>

function abrirFlores() {


    /* Ocultar pantalla inicial */

    document
        .getElementById("inicio")
        .style.display = "none";


    /* Mostrar jardín */

    const jardin =
        document.getElementById("jardin");

    jardin.classList.add("activo");



    /* =========================
       PARTÍCULAS DORADAS
    ========================= */

    for (
        let i = 0;
        i < 45;
        i++
    ) {

        const p =
            document.createElement("div");

        p.className =
            "particula";


        p.style.left =
            Math.random() * 100 + "%";


        p.style.animationDuration =
            (4 + Math.random() * 6) + "s";


        p.style.animationDelay =
            Math.random() * 5 + "s";


        jardin.appendChild(p);

    }



    /* =========================
       CORAZONES
    ========================= */

    for (
        let i = 0;
        i < 15;
        i++
    ) {

        const c =
            document.createElement("div");


        c.className =
            "corazon";


        c.innerHTML =
            "♥";


        c.style.left =
            Math.random() * 100 + "%";


        c.style.bottom =
            "-50px";


        c.style.animationDuration =
            (5 + Math.random() * 5) + "s";


        c.style.animationDelay =
            Math.random() * 5 + "s";


        jardin.appendChild(c);

    }

}

</script>


</body>
</html>
